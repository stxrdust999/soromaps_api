// ─────────────────────────────────────────────────────────────────────────────
// Soromaps — estrutura de banco proposta a partir das funcionalidades atuais.
// Cole em https://dbdiagram.io para visualizar.
//
// Este arquivo é a FONTE DE VERDADE do modelo. Os `.md` desta pasta recortam
// pedaços dele para explicar o porquê — snippet que divergir daqui está errado.
//
// Estado real do banco hoje: DUAS tabelas (`tbUsuario`, `markers`), sem FK
// entre elas e sem migrations. Ver docs/wiki/08-banco-atual.md.
// ─────────────────────────────────────────────────────────────────────────────

Project soromaps {
  database_type: 'PostgreSQL'
  Note: '''
  Modelo derivado do que as telas já fazem, não do modelo lógico do TCC.

  Diferenças deliberadas em relação a docs/wiki/05-modelagem-projetada.md:
    - sem `Segue` (decisão de 2026-08-17: feed sem grafo social)
    - sem `tipoUsuario`/`CNPJ`/`UsuarioDono` (decisão de 2026-08-19: dono de
      estabelecimento saiu do produto)
    - sem `pontuacao`/`nivel` (decisão de 2026-08-12: título derivado de
      COUNT(ganha_conquista))
    - `denuncia`, `feedback`, `remocao_conteudo`, `decisao_moderacao`,
      `pauta` e `feed_silenciado` são adição nossa: as telas existem e não
      tinham contraparte no modelo do TCC.

  Convenção: snake_case, tabela no singular, pt-BR. Os `Enum` abaixo viram
  `varchar` + `CHECK` na migration — ver 01-identidade-e-acesso.md.
  '''
}

// ── Enums ────────────────────────────────────────────────────────────────────

Enum papel_usuario {
  explorador
  admin
}

Enum status_ponto {
  pendente  [note: 'Recém-sugerido, aguardando moderação']
  devolvido [note: 'Faltou dado; o autor pode completar e reenviar']
  aprovado  [note: 'Único status que aparece no mapa público']
  rejeitado
}

Enum status_conteudo {
  publicada
  removida
}

Enum origem_visita {
  gps    [note: 'Check-in com a posição conferida']
  manual [note: 'Marcado pela pessoa, sem conferência']
}

Enum evento_conquista {
  visitar
  avaliar
  criar
  favoritar
  sequencia
  // sem `seguir`: `Segue` saiu do produto em 2026-08-17
}

Enum tipo_alvo_conquista {
  categoria
  bairro
}

Enum decisao_ponto {
  aprovado
  devolvido
  rejeitado
}

Enum tipo_alvo_moderavel {
  avaliacao
  comentario
  ponto
  perfil
}

Enum motivo_denuncia {
  spam
  ofensa
  falsa
  improprio
  escopo
}

Enum status_denuncia {
  aberta
  resolvida
  arquivada
}

Enum tipo_feedback {
  bug
  sugestao
  elogio
}

Enum status_feedback {
  novo
  lido
  respondido
}

Enum origem_pauta {
  ia
  equipe
}

Enum status_pauta {
  rascunho
  publicada
}

Enum escopo_silenciado {
  bairro
  categoria
  tipo
}

// ── Identidade ───────────────────────────────────────────────────────────────

Table usuario {
  id            integer       [pk, increment]
  nome          varchar(80)   [not null, unique, note: 'É o identificador de login hoje — daí o UNIQUE']
  email         varchar(160)  [not null, unique]
  senha_hash    varchar(72)   [not null, note: 'BCrypt, gerado na API']
  papel         papel_usuario [not null, default: 'explorador']

  avatar_url    varchar(500)
  bio           varchar(280)
  bairro        varchar(60)   [note: 'Bairro declarado — ranking por bairro em /community']

  criado_em     timestamptz   [not null, default: `now()`]
  atualizado_em timestamptz   [not null, default: `now()`]

  Note: '''
  Renomeia `tbUsuario`. Nenhuma coluna some; entram `papel`, `avatar_url`,
  `bio` e `bairro`.

  `papel` é o que destrava o gate de /admin e o de editar/excluir ponto —
  hoje qualquer sessão válida faz as duas coisas.

  NÃO tem `pontuacao` nem `nivel`: o título ("Guia local · 8 conquistas") é
  função pura sobre COUNT(ganha_conquista), em src/constants/explorer-titles.ts.

  Sem tabela de sessão: o cookie é JWT HS256 assinado pelo Next.
  '''
}

// ── Lugar e catálogo ─────────────────────────────────────────────────────────

Table categoria {
  id            integer     [pk, increment]
  nome          varchar(60) [not null, unique]
  slug          varchar(60) [not null, unique, note: 'Deriva do nome no save; vira /discover?categoria=...']
  icone         varchar(40) [not null, note: 'Chave de CATEGORY_ICONS, não nome livre do lucide']
  cor           char(7)     [not null, note: 'Hex #rrggbb da paleta pré-aprovada']
  ordem         smallint    [not null, note: 'Posição nos filtros do app; 1..n sem buraco']
  ativa         boolean     [not null, default: true, note: 'Inativa some dos filtros e mantém os pontos vinculados']

  criado_em     timestamptz [not null, default: `now()`]
  atualizado_em timestamptz [not null, default: `now()`]

  Note: 'Contagem de pontos e novos-na-semana são agregados sobre `ponto`, não colunas.'
}

Table ponto {
  id             integer      [pk, increment]
  nome           varchar(120) [not null]
  lat            double       [not null]
  lng            double       [not null]
  bairro         varchar(60)  [not null, note: 'Eixo de feed, ranking, cobertura do perfil e alvo de conquista']
  categoria_id   integer      [ref: > categoria.id, note: 'ON DELETE RESTRICT: excluir categoria exige reatribuir antes']
  autor_id       integer      [ref: > usuario.id, note: 'Quem sugeriu. Resolve a FK que `markers` nunca teve']

  sobre          varchar(160) [note: 'Chamada de uma linha — card e popup do mapa']
  descricao      varchar(600)
  tem_wifi       boolean      [not null, default: false]
  pet_friendly   boolean      [not null, default: false]
  melhor_horario varchar(60)
  segredo_local  varchar(200)

  status         status_ponto [not null, default: 'pendente']
  criado_em      timestamptz  [not null, default: `now()`]
  atualizado_em  timestamptz  [not null, default: `now()`]

  indexes {
    status
    categoria_id
    bairro
    (lat, lng) [name: 'idx_ponto_bbox']
  }

  Note: '''
  Renomeia `markers` e absorve a proposta de 2026-08-03 (foto, sobre,
  categoria, amenidades, melhor horário, segredo local) — hoje o formulário de
  /places/new coleta esses campos e a API descarta.

  `nota` e `total_avaliacoes` NÃO são colunas: são agregados sobre `analise`
  publicada. Coluna acumuladora dessincroniza quando a moderação remove uma
  avaliação.

  `distancia` também não é coluna: depende de quem está olhando.
  '''
}

Table ponto_foto {
  id          integer      [pk, increment]
  ponto_id    integer      [not null, ref: > ponto.id]
  url         varchar(500) [not null]
  capa        boolean      [not null, default: false]
  enviada_por integer      [ref: > usuario.id]
  criado_em   timestamptz  [not null, default: `now()`]

  indexes {
    ponto_id
  }

  Note: '''
  Tabela e não coluna porque a página do local tem galeria e a moderação conta
  fotos por sugestão.

  Uma capa por ponto: índice único parcial
  `CREATE UNIQUE INDEX ... ON ponto_foto (ponto_id) WHERE capa` — DBML não
  expressa índice parcial.
  '''
}

Table tag {
  id   integer     [pk, increment]
  nome varchar(40) [not null, unique, note: 'wifi, calmo, ar livre, trabalho…']
  slug varchar(40) [not null, unique]

  Note: 'Segundo eixo de busca do /discover: categoria diz "o que é", tag diz "pra quê".'
}

Table ponto_tag {
  ponto_id integer [ref: > ponto.id]
  tag_id   integer [ref: > tag.id]

  indexes {
    (ponto_id, tag_id) [pk]
  }
}

// ── Contribuição ─────────────────────────────────────────────────────────────

Table analise {
  id            integer         [pk, increment]
  ponto_id      integer         [not null, ref: > ponto.id]
  usuario_id    integer         [not null, ref: > usuario.id]
  nota          smallint        [not null, note: 'CHECK entre 1 e 5']
  corpo         varchar(1000)   [not null]
  foto_url      varchar(500)    [note: 'Foto anexada à avaliação — aparece no card do feed']
  status        status_conteudo [not null, default: 'publicada']

  criado_em     timestamptz     [not null, default: `now()`]
  atualizado_em timestamptz     [not null, default: `now()`]

  indexes {
    (ponto_id, status)
    usuario_id
  }

  Note: '''
  SEM unique em (ponto_id, usuario_id): avaliar o mesmo lugar duas vezes é um
  SINAL que /admin/reviews mostra ("duplicada"), não um erro que o banco
  bloqueia. Constraint aqui apagaria a evidência que a tela precisa exibir.

  `uteis` é COUNT sobre `analise_util`, não coluna.
  '''
}

Table analise_util {
  analise_id integer     [ref: > analise.id]
  usuario_id integer     [ref: > usuario.id]
  criado_em  timestamptz [not null, default: `now()`]

  indexes {
    (analise_id, usuario_id) [pk]
  }

  Note: '''
  "Útil" e não "curtir": mede se a dica ajudou a decidir, e é o que ordena
  avaliação na página do ponto.

  PK composta = idempotente. Contador acumulador em coluna erraria para sempre
  ao ser processado duas vezes.
  '''
}

Table comentario {
  id            integer         [pk, increment]
  analise_id    integer         [not null, ref: > analise.id, note: 'Pendurado na análise, não no ponto — RF-09 pede conversa em torno da avaliação']
  usuario_id    integer         [not null, ref: > usuario.id]
  resposta_a_id integer         [ref: > comentario.id, note: 'Auto-referência: comentário COM RESPOSTA (RF-09)']
  corpo         varchar(600)    [not null]
  status        status_conteudo [not null, default: 'publicada']
  criado_em     timestamptz     [not null, default: `now()`]

  indexes {
    (analise_id, status)
  }
}

// ── Atividade ────────────────────────────────────────────────────────────────

Table visita {
  usuario_id  integer       [ref: > usuario.id]
  ponto_id    integer       [ref: > ponto.id]
  visitado_em timestamptz   [not null]
  origem      origem_visita [not null, default: 'manual']

  indexes {
    (usuario_id, ponto_id, visitado_em) [pk]
    (usuario_id, visitado_em)
  }

  Note: '''
  Data na PK porque visita é EVENTO REPETÍVEL: a timeline de /profile/visits
  mostra o mesmo café três vezes de propósito, e deduplicar mentiria.

  Alimenta: motivo `perto`/`categoria` do feed, cobertura da cidade em
  /profile/stats, critério `visitar`/`sequencia` das conquistas e o mínimo de
  5 visitas do selo de verificado.
  '''
}

Table favorita {
  usuario_id integer     [ref: > usuario.id]
  ponto_id   integer     [ref: > ponto.id]
  criado_em  timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, ponto_id) [pk]
  }

  Note: '''
  Sem data na PK: favoritar é ESTADO, não evento — desfavoritar é DELETE.
  É o "acompanhar lugar" que substituiu o "seguir pessoa", e o que dá o motivo
  `salvo` do feed.
  '''
}

Table feed_silenciado {
  usuario_id integer           [ref: > usuario.id]
  escopo     escopo_silenciado
  valor      varchar(40)       [note: 'Nome do bairro, da categoria ou a chave do tipo de item']
  criado_em  timestamptz       [not null, default: `now()`]

  indexes {
    (usuario_id, escopo, valor) [pk]
  }

  Note: '''
  "Ver menos disso" em três escopos. Persiste porque o chip removível com
  contador tem que sobreviver ao F5 — filtro que o usuário esqueceu de ter
  criado é pior que filtro nenhum.

  NÃO existe tabela de feed: item de feed é CONSULTA. `motivo` e `relevancia`
  são colunas calculadas na query, não linhas guardadas.
  '''
}

// ── Gamificação ──────────────────────────────────────────────────────────────

Table conquista {
  id            integer             [pk, increment]
  nome          varchar(60)         [not null, unique]
  descricao     varchar(160)        [not null]
  icone         varchar(40)         [not null, note: 'Chave de ACHIEVEMENT_ICONS']
  cor           char(7)             [not null]

  evento        evento_conquista    [not null]
  quantidade    integer             [not null, note: 'CHECK >= 1']
  tipo_alvo     tipo_alvo_conquista [note: 'null = critério sem alvo']
  alvo          varchar(60)         [note: 'Nome da categoria ou do bairro']

  ativa         boolean             [not null, default: true]
  criado_em     timestamptz         [not null, default: `now()`]
  atualizado_em timestamptz         [not null, default: `now()`]

  Note: '''
  Critério declarativo: (evento, quantidade, tipo_alvo, alvo) monta a frase
  "Visitar 5 lugares da categoria Cafeteria". Conquista nova é INSERT, não
  deploy.

  CHECK: (tipo_alvo IS NULL) = (alvo IS NULL) — escolher o tipo obriga o alvo,
  senão o motor não tem o que comparar.

  SEM coluna de XP ou pontos (decisão de 2026-08-12). `obtencoes` e `raridade`
  da tela de admin são agregados sobre `ganha_conquista`.
  '''
}

Table ganha_conquista {
  usuario_id   integer     [ref: > usuario.id]
  conquista_id integer     [ref: > conquista.id]
  obtida_em    timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, conquista_id) [pk]
  }

  Note: '''
  PK composta é a decisão inteira: conquista é ESTADO IDEMPOTENTE, então errar
  o critério e reprocessar o motor é seguro. Era isso que XP não conseguia dar
  sem uma tabela de transações.

  COUNT desta tabela por usuário = o título do explorador.
  '''
}

// ── Moderação ────────────────────────────────────────────────────────────────

Table decisao_moderacao {
  id           integer       [pk, increment]
  ponto_id     integer       [not null, ref: > ponto.id]
  moderador_id integer       [not null, ref: > usuario.id]
  decisao      decisao_ponto [not null]
  motivo       varchar(40)   [note: 'Lista fechada de REJECTION_REASONS; null em aprovação']
  observacao   varchar(300)
  criado_em    timestamptz   [not null, default: `now()`]

  indexes {
    ponto_id
    criado_em
  }

  Note: '''
  Log append-only. `ponto.status` é o estado atual; esta tabela é como ele
  chegou lá. "Desfazer" dentro de 24 h é UMA LINHA NOVA, nunca um DELETE — o
  histórico da fila precisa mostrar que houve reversão.

  Tempo médio de decisão e "decididos hoje" saem daqui.
  '''
}

Table denuncia {
  id             integer             [pk, increment]
  alvo_tipo      tipo_alvo_moderavel [not null]
  alvo_id        integer             [not null, note: 'Polimórfico: sem FK — ver a nota da tabela']
  denunciante_id integer             [not null, ref: > usuario.id]
  motivo         motivo_denuncia     [not null]
  status         status_denuncia     [not null, default: 'aberta']
  resolvido_por  integer             [ref: > usuario.id]
  resolvido_em   timestamptz
  criado_em      timestamptz         [not null, default: `now()`]

  indexes {
    (alvo_tipo, alvo_id, denunciante_id) [unique]
    (alvo_tipo, alvo_id)
    status
  }

  Note: '''
  Alvo polimórfico (avaliação, comentário, ponto, perfil) porque a fila é uma
  só e agrupa por alvo. CUSTO ACEITO E REGISTRADO: o banco não impõe
  integridade referencial em `alvo_id`, então a aplicação vira responsável por
  não deixar denúncia órfã. A alternativa — quatro colunas FK nullable com
  CHECK de exclusividade — dá integridade e transforma toda consulta da fila
  num COALESCE de quatro caminhos.

  O UNIQUE (alvo_tipo, alvo_id, denunciante_id) é o que sustenta o selo de
  denúncia coordenada: cinco denúncias no mesmo alvo são cinco pessoas, nunca
  uma pessoa clicando cinco vezes.
  '''
}

Table remocao_conteudo {
  id           integer             [pk, increment]
  alvo_tipo    tipo_alvo_moderavel [not null]
  alvo_id      integer             [not null]
  motivo       varchar(40)         [not null, note: 'REMOVAL_REASONS — o MESMO vocabulário nas duas telas']
  moderador_id integer             [not null, ref: > usuario.id]
  denuncia_id  integer             [ref: > denuncia.id, note: 'null quando o admin removeu varrendo, sem denúncia']
  criado_em    timestamptz         [not null, default: `now()`]

  indexes {
    (alvo_tipo, alvo_id)
  }

  Note: '''
  Uma tabela para os dois caminhos de remoção: /admin/reports remove reagindo a
  denúncia, /admin/reviews remove varrendo por conta própria. Duas tabelas
  divergiriam no primeiro ajuste de regra e quebrariam a métrica de moderação.

  A remoção em si é `status = removida` no conteúdo; esta tabela é o porquê.
  '''
}

Table feedback {
  id            integer         [pk, increment]
  usuario_id    integer         [ref: > usuario.id, note: 'null = envio anônimo, que não tem canal de resposta']
  tipo          tipo_feedback   [not null]
  mensagem      varchar(2000)   [not null]
  status        status_feedback [not null, default: 'novo']
  rota          varchar(120)    [note: 'Só bug: onde aconteceu']
  dispositivo   varchar(80)     [note: 'Só bug: navegador e sistema']
  criado_em     timestamptz     [not null, default: `now()`]
  respondido_em timestamptz

  Note: 'Não tem alvo: é sobre o produto, não sobre conteúdo de outro usuário — não há o que remover nem quem punir.'
}

// ── Editorial ────────────────────────────────────────────────────────────────

Table pauta {
  id            integer      [pk, increment]
  slug          varchar(80)  [not null, unique, note: 'URL pública /pautas/[slug]']
  chapeu        varchar(24)  [not null]
  titulo        varchar(90)  [not null]
  chamada       varchar(220) [not null]
  corpo         jsonb        [not null, note: 'Array de parágrafos, 3 a 6 — mesma régua do storyDraftSchema']
  foto_url      varchar(500)

  origem        origem_pauta [not null]
  modelo        varchar(40)  [note: 'Modelo que redigiu; obrigatório quando origem = ia']
  status        status_pauta [not null, default: 'rascunho']
  revisado_por  integer      [ref: > usuario.id, note: 'Obrigatório para publicar']
  publicado_em  timestamptz
  tempo_leitura smallint     [not null, note: 'Minutos']

  criado_em     timestamptz  [not null, default: `now()`]
  atualizado_em timestamptz  [not null, default: `now()`]

  indexes {
    status
  }

  Note: '''
  Dois CHECK carregam regra de produto, não capricho:
    - origem = 'ia' obriga `modelo` — pauta de IA aparece ROTULADA ao leitor
    - status = 'publicada' obriga `revisado_por` e `publicado_em` — geração é
      etapa de autoria, publicar é decisão de gente

  Rascunho responde 404 na rota pública.
  '''
}

Table pauta_ponto {
  pauta_id integer  [ref: > pauta.id]
  ponto_id integer  [ref: > ponto.id]
  ordem    smallint [not null]

  indexes {
    (pauta_id, ponto_id) [pk]
  }

  Note: '''
  De 2 a 4 lugares por pauta (MIN_PLACES/MAX_PLACES). É esta tabela que fecha a
  lista de lugares entregue ao modelo: ele recebe ficha de fatos de pontos que
  existem e não escolhe assunto sozinho.
  '''
}
