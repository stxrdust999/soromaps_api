// DBML — Database Markup Language (Módulo de Usuários)
// Cole o conteúdo deste arquivo em https://dbdiagram.io para visualização interativa.

Project soromaps_users {
  database_type: 'PostgreSQL'
  Note: 'Recorte da modelagem focado no Módulo de Usuários e Sessões.'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único universal aleatório']
  name varchar(100) [not null, note: 'Nome de exibição do usuário']
  email varchar(255) [not null, unique, note: 'E-mail para autenticação']
  password_hash varchar [not null, note: 'Hash BCrypt da senha (workFactor: 12)']
  role varchar(20) [not null, default: 'explorer', note: 'Papel no sistema: explorer ou admin']
  avatar_url varchar(500) [null, note: 'URL da imagem de perfil no Supabase Storage']
  biography varchar(280) [null, note: 'Bio breve do explorador']
  neighborhood varchar(60) [null, note: 'Bairro declarado em Sorocaba']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Tabela principal de contas de usuários gerenciada pelo EF Core.'
}

Table sessions {
  id bigint [pk, increment, note: 'ID sequencial da sessão']
  user_id uuid [not null, ref: > users.id, note: 'Vínculo com o usuário']
  token_hash char(64) [not null, unique, note: 'Hash SHA-256 do refresh token']
  expires_at timestamptz [not null, note: 'Data de expiração do refresh token (7 dias)']
  revoked_at timestamptz [null, note: 'Data de revogação por logout ou rotação']
  user_agent varchar(300) [null, note: 'Dispositivo / navegador do cliente']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Controle de sessões e rotação de refresh tokens.'
}
