// DBML — Database Markup Language (Modelo Completo Soromaps)
// Cole o conteúdo deste arquivo em https://dbdiagram.io para gerar o diagrama visual interativo.

Project soromaps {
  database_type: 'PostgreSQL'
  Note: 'Modelo de dados completo da plataforma Soromaps — Schema public.'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar [not null]
  role varchar(20) [not null, default: 'explorer']
  avatar_url varchar(500) [null]
  biography varchar(280) [null]
  neighborhood varchar(60) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table sessions {
  id bigint [pk, increment]
  user_id uuid [not null, ref: > users.id]
  token_hash char(64) [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz [null]
  user_agent varchar(300) [null]
  created_at timestamptz [not null, default: `now()`]
}

Table categories {
  id int [pk, increment]
  name varchar(60) [not null, unique]
  slug varchar(60) [not null, unique]
  icon varchar(40) [not null]
  color varchar(7) [not null]
  order smallint [not null, default: 0]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table places {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(120) [not null]
  latitude double [not null]
  longitude double [not null]
  about varchar(160) [not null]
  description text [not null]
  neighborhood varchar(60) [not null]
  category_id int [not null, ref: > categories.id]
  author_id uuid [not null, ref: > users.id]
  has_wifi boolean [not null, default: false]
  pet_friendly boolean [not null, default: false]
  best_time varchar(60) [null]
  local_secret varchar(200) [null]
  status varchar(20) [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table place_photos {
  id uuid [pk, default: `gen_random_uuid()`]
  place_id uuid [not null, ref: > places.id]
  url varchar(500) [not null]
  is_cover boolean [not null, default: false]
  uploaded_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
}

Table tags {
  id int [pk, increment]
  name varchar(40) [not null, unique]
  slug varchar(40) [not null, unique]
}

Table place_tags {
  place_id uuid [ref: > places.id]
  tag_id int [ref: > tags.id]

  indexes {
    (place_id, tag_id) [pk]
  }
}

Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  place_id uuid [not null, ref: > places.id]
  user_id uuid [not null, ref: > users.id]
  rating smallint [not null]
  comment text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table visits {
  id uuid [pk, default: `gen_random_uuid()`]
  place_id uuid [not null, ref: > places.id]
  user_id uuid [not null, ref: > users.id]
  visited_at timestamptz [not null, default: `now()`]
}

Table favorites {
  place_id uuid [ref: > places.id]
  user_id uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (place_id, user_id) [pk]
  }
}

Table achievements {
  id int [pk, increment]
  title varchar(80) [not null, unique]
  slug varchar(80) [not null, unique]
  description varchar(200) [not null]
  icon varchar(40) [not null]
  points int [not null, default: 10]
}

Table user_achievements {
  user_id uuid [ref: > users.id]
  achievement_id int [ref: > achievements.id]
  unlocked_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, achievement_id) [pk]
  }
}
